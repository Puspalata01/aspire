# ASPIRE — environment template (copy to .env, fill in, never commit .env)

# Supabase Postgres 16 + PostGIS (required for DB-backed features)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Redis (Upstash or self-hosted)
REDIS_URL=redis://localhost:6379

# Python ML microservice (docs/02 §5)
ML_SERVICE_URL=http://localhost:8001/api/v1

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=kdddddddddddddddddkddk

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=debug
