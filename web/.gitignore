# Root gitignore — ASPIRE monorepo

# Working agreements & checklists (never commit)
AGENTS.md
BACKEND_CHECKLIST.md
*-CHECKLIST.md

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node (web/)
node_modules/
.next/
out/
build/
*.tsbuildinfo

# Logs & OS
*.log
.DS_Store
